# Neon Postgres connection string (get this from neon.com — free tier).
# Use the "HTTP" style connection string shown on your Neon dashboard,
# a standard postgresql:// URL works fine here too since we only use
# the HTTP driver, not raw TCP.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-random-generated-secret"
